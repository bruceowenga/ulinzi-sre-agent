GRAFANA_API_KEY=your_grafana_api_key_here
NTFY_TOKEN=your_ntfy_token_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here

# Optional overrides (defaults work for local Odin setup)
# PROMETHEUS_URL=http://localhost:9090
# DRY_RUN=false

# Optional: NVIDIA NIM inference (set key to override local Ollama)
# NVIDIA_BUILD_API_KEY=nvapi-...
# PRIMARY_MODEL=minimaxai/minimax-m2.7
# FALLBACK_MODEL=minimaxai/minimax-m2.7